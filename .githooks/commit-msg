#!/bin/bash
# Public-repo boundary guard: denies commit messages containing private terms.
# The denylist is deliberately NOT in this public repo — one term per line in
# ~/.claude/private-terms.txt (case-insensitive match).
set -uo pipefail
terms="$HOME/.claude/private-terms.txt"
[ -f "$terms" ] || exit 0
while IFS= read -r term; do
    [ -n "$term" ] || continue
    if grep -qi -- "$term" "$1"; then
        echo "BLOCKED: commit message contains a private term from ~/.claude/private-terms.txt — this repo is public." >&2
        exit 1
    fi
done < "$terms"
exit 0
